# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="DocuMind AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documind_db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/documind_db"

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=25

# Vector DB (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=""

# Redis (Async Worker / Caching)
REDIS_URL="redis://localhost:6379/0"
